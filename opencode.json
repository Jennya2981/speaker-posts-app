{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "read": {
      "*": "allow",
      ".env": "deny",
      ".env.*": "deny",
      "**/.env": "deny",
      "**/.env.*": "deny",
      ".env.example": "allow",
      "**/.env.example": "allow"
    },
    "edit": "ask",
    "bash": {
      "*": "ask",
      "git status*": "allow",
      "rm*": "deny"
    },
    "glob": "ask",
    "grep": "ask",
    "list": "ask",
    "task": "ask",
    "todowrite": "ask",
    "webfetch": "ask",
    "websearch": "ask",
    "lsp": "ask",
    "skill": "ask"
  }
}